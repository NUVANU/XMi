          "fingerprint": "$result.data.proposal_fingerprint",
          "intent": "SELECT_MODE",
          "change": "SELECT"
        },
        "form": "accept",
        "expect": {
          "ok": true,
          "version": 2,
          "mode": "FAST_VALIDATION"
        }
      },
      {
        "kind": "tool",
        "name": "xmi_project_get",
        "args": {
          "schema_version": "0.1.0",
          "project_id": "$project_id"
        },
        "form": "none",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "user",
        "text": "请让我确认刚才那条社区工具预约的具体需求。"
      },
      {
        "kind": "tool",
        "name": "xmi_item_confirm",
        "args": {
          "schema_version": "0.1.0",
          "project_id": "$project_id",
          "expected_version": "$version",
          "idempotency_key": "confirm",
          "item_id": "$item.id",
          "item_version": "$item.version",
          "fingerprint": "$item.fingerprint",
          "intent": "CONFIRM"
        },
        "form": "accept",
        "expect": {
          "ok": true,
          "version": 3,
          "first_status": "CONFIRMED"
        }
      },
      {
        "kind": "tool",
        "name": "xmi_project_get",
        "args": {
          "schema_version": "0.1.0",
          "project_id": "$project_id"
        },
        "form": "none",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "assistant",
        "text": "工具结果和刷新后的状态记录了这条确认。交付目标是快速验证，尚未经过可交付评估。",
