        ],
        "claims": {
          "confirmed_ids": [
            "$item.id"
          ],
          "selected_mode": "FAST_VALIDATION",
          "saved": true,
          "readiness": "NOT_EVALUATED",
          "final_spec": false,
          "confirmation_mechanism_verified": false,
          "implementation_tasks": []
        }
      }
