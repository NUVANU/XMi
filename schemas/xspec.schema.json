{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmi.example/schemas/xspec.schema.json",
  "title": "XSpec 0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_id",
    "spec_version",
    "project",
    "profile",
    "delivery_profile",
    "product_vision",
    "actors",
    "goals",
    "out_of_scope",
    "user_flows",
    "requirements",
    "acceptance_criteria",
    "data_entities",
    "permission_rules",
    "integrations",
    "non_functional_requirements",
    "decisions",
    "risks",
    "solution_blueprint",
    "readiness",
    "provenance_summary",
    "generated_at",
    "reference_records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^XSPEC-[A-Z0-9-]+$"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "name",
        "summary"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "supported"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "supported": {
          "type": "boolean"
        }
      }
    },
    "product_vision": {
      "$ref": "#/$defs/simpleConfirmed"
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simpleConfirmed"
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simpleConfirmed"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simpleConfirmed"
      }
    },
    "user_flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptance"
      }
    },
    "data_entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simpleConfirmed"
      }
    },
    "permission_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simpleConfirmed"
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simpleConfirmed"
      }
    },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simpleConfirmed"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/simpleConfirmed"
      }
    },
    "solution_blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "recommended_option",
        "constraints",
        "delegated_to_xdev"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "CONFIRMED",
            "DELEGATED_TO_XDEV"
          ]
        },
        "recommended_option": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delegated_to_xdev": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_capability_profile": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    },
    "provenance_summary": {
      "type": "object",
      "required": [
        "confirmed_count",
        "source_ref_count"
      ],
      "properties": {
        "confirmed_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_ref_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_profile": {
      "$ref": "#/$defs/deliveryProfile"
    },
    "reference_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceRecord"
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "flow": {
      "allOf": [
        {
          "$ref": "#/$defs/baseConfirmed"
        },
        {
          "type": "object",
          "required": [
            "actor_ids",
            "steps",
            "failure_paths"
          ],
          "properties": {
            "actor_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "failure_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "requirement": {
      "allOf": [
        {
          "$ref": "#/$defs/baseConfirmed"
        },
        {
          "type": "object",
          "required": [
            "acceptance_criterion_ids"
          ],
          "properties": {
            "acceptance_criterion_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "acceptance": {
      "allOf": [
        {
          "$ref": "#/$defs/baseConfirmed"
        },
        {
          "type": "object",
          "required": [
            "requirement_ids",
            "testability"
          ],
          "properties": {
            "requirement_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "testability": {
              "type": "string",
              "enum": [
                "AUTOMATED",
                "MANUAL",
                "MIXED"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "decision": {
      "allOf": [
        {
          "$ref": "#/$defs/baseConfirmed"
        },
        {
          "type": "object",
          "required": [
            "selected_option",
            "alternatives"
          ],
          "properties": {
            "selected_option": {
              "type": "string"
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "hard_gates",
        "blocking_count",
        "audit_run_id",
        "owner_confirmed_export",
        "target_mode",
        "target_level",
        "achieved_level",
        "assurance_level",
        "mode_gap_count"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_READY",
            "READY_FOR_XDEV"
          ]
        },
        "hard_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "passed"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "details": {
                "type": "string"
              }
            }
          }
        },
        "blocking_count": {
          "type": "integer",
          "minimum": 0
        },
        "audit_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_confirmed_export": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "target_mode": {
          "$ref": "#/$defs/deliveryMode"
        },
        "target_level": {
          "type": "string",
          "enum": [
            "PROTOTYPE_READY",
            "BUILD_READY",
            "PRODUCT_SPEC_READY"
          ]
        },
        "achieved_level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "PROTOTYPE_READY",
            "BUILD_READY",
            "PRODUCT_SPEC_READY",
            null
          ]
        },
        "assurance_level": {
          "type": "string",
          "enum": [
            "BASIC_SELF_CHECK",
            "INDEPENDENT_SPEC_REVIEW",
            "INDEPENDENT_PRODUCT_AUDIT"
          ]
        },
        "mode_gap_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target_mode": {
                "const": "FAST_VALIDATION"
              }
            },
            "required": [
              "target_mode"
            ]
          },
          "then": {
            "properties": {
              "target_level": {
                "const": "PROTOTYPE_READY"
              },
              "assurance_level": {
                "const": "BASIC_SELF_CHECK"
              }
            },
            "required": [
              "target_level",
              "assurance_level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "target_mode": {
                "const": "FAST_DEVELOPMENT"
              }
            },
            "required": [
              "target_mode"
            ]
          },
          "then": {
            "properties": {
              "target_level": {
                "const": "BUILD_READY"
              },
              "assurance_level": {
                "const": "INDEPENDENT_SPEC_REVIEW"
              }
            },
            "required": [
              "target_level",
              "assurance_level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "target_mode": {
                "const": "PRODUCT_GRADE"
              }
            },
            "required": [
              "target_mode"
            ]
          },
          "then": {
            "properties": {
              "target_level": {
                "const": "PRODUCT_SPEC_READY"
              },
              "assurance_level": {
                "const": "INDEPENDENT_PRODUCT_AUDIT"
              }
            },
            "required": [
              "target_level",
              "assurance_level"
            ]
          }
        }
      ]
    },
    "baseConfirmed": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "status",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "CONFIRMED"
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "simpleConfirmed": {
      "allOf": [
        {
          "$ref": "#/$defs/baseConfirmed"
        }
      ],
      "unevaluatedProperties": false
    },
    "deliveryMode": {
      "type": "string",
      "enum": [
        "FAST_VALIDATION",
        "FAST_DEVELOPMENT",
        "PRODUCT_GRADE"
      ]
    },
    "deliveryScopeOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope_ids",
        "minimum_mode",
        "resolution",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scope_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "minimum_mode": {
          "$ref": "#/$defs/deliveryMode"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "UPGRADE_SCOPE",
            "UPGRADE_PROJECT",
            "STUB_OR_SANDBOX",
            "DEFER_OR_EXCLUDE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deliveryProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_mode",
        "selection_source",
        "readiness_target",
        "scope_overrides"
      ],
      "properties": {
        "project_mode": {
          "$ref": "#/$defs/deliveryMode"
        },
        "selection_source": {
          "type": "string",
          "enum": [
            "OWNER_CONFIRMED",
            "IMPORTED_SUITE_POLICY"
          ]
        },
        "readiness_target": {
          "type": "string",
          "enum": [
            "PROTOTYPE_READY",
            "BUILD_READY",
            "PRODUCT_SPEC_READY"
          ]
        },
        "scope_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deliveryScopeOverride"
          }
        },
        "handoff_contract_version": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "project_mode": {
                "const": "FAST_VALIDATION"
              }
            },
            "required": [
              "project_mode"
            ]
          },
          "then": {
            "properties": {
              "readiness_target": {
                "const": "PROTOTYPE_READY"
              }
            },
            "required": [
              "readiness_target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "project_mode": {
                "const": "FAST_DEVELOPMENT"
              }
            },
            "required": [
              "project_mode"
            ]
          },
          "then": {
            "properties": {
              "readiness_target": {
                "const": "BUILD_READY"
              }
            },
            "required": [
              "readiness_target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "project_mode": {
                "const": "PRODUCT_GRADE"
              }
            },
            "required": [
              "project_mode"
            ]
          },
          "then": {
            "properties": {
              "readiness_target": {
                "const": "PRODUCT_SPEC_READY"
              }
            },
            "required": [
              "readiness_target"
            ]
          }
        }
      ]
    },
    "referenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "item_type",
        "status",
        "item_version",
        "statement",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "CONFIRMED_CONSTRAINT",
            "HISTORICAL"
          ]
        },
        "item_type": {
          "enum": [
            "vision",
            "actor",
            "goal",
            "flow",
            "functional_requirement",
            "acceptance_criterion",
            "data_entity",
            "permission_rule",
            "integration",
            "non_functional_requirement",
            "decision",
            "risk",
            "exclusion",
            "constraint",
            "solution_constraint",
            "solution_blueprint"
          ]
        },
        "status": {
          "enum": [
            "CONFIRMED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "item_version": {
          "type": "integer",
          "minimum": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "CONFIRMED_CONSTRAINT"
            },
            "status": {
              "const": "CONFIRMED"
            },
            "item_type": {
              "enum": [
                "constraint",
                "solution_constraint"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "HISTORICAL"
            },
            "status": {
              "enum": [
                "REJECTED",
                "SUPERSEDED"
              ]
            }
          }
        }
      ]
    }
  }
}
