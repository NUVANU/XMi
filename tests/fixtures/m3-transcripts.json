[
  {
    "id": "explicit-proposal-not-confirmed",
    "invocation": "explicit",
    "request": "$xmi-discovery 我想做社区工具预约，帮我理清范围。",
    "steps": [
      {
        "kind": "assistant",
        "text": "先弄清第一版要解决什么，暂时不生成最终规格。",
        "questions": [
          "谁会借用工具？",
          "最重要的一次预约流程是什么？"
        ],
        "claims": {
          "confirmed_ids": [],
          "selected_mode": null,
          "saved": false,
          "readiness": "NOT_EVALUATED",
          "final_spec": false,
          "confirmation_mechanism_verified": false,
          "implementation_tasks": []
        }
      },
      {
        "kind": "tool",
        "name": "xmi_project_create",
        "args": {
          "schema_version": "0.1.0",
          "initial_idea": "居民预约共享工具",
          "source_ref": {
            "type": "conversation_turn",
            "ref": "fixture:owner"
          },
          "idempotency_key": "intake"
        },
        "form": "accept",
        "expect": {
          "ok": true,
          "version": 1,
          "first_status": "PROPOSED"
        }
      },
      {
        "kind": "tool",
        "name": "xmi_project_get",
        "args": {
          "schema_version": "0.1.0",
          "project_id": "$project_id"
        },
        "form": "none",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "user",
        "text": "居民想预约钻孔机，但是否收费还不知道。"
      },
      {
        "kind": "tool",
        "name": "xmi_answer_analyze",
        "args": {
          "schema_version": "0.1.0",
          "project_id": "$project_id",
          "expected_version": "$version",
          "answer": "居民想预约钻孔机，但是否收费还不知道。",
          "item_id": "REQ-BOOK",
          "item_type": "functional_requirement",
          "source_ref": {
            "type": "conversation_turn",
            "ref": "fixture:owner"
          }
        },
        "form": "none",
        "expect": {
          "ok": true,
          "version": 1
        }
      },
      {
        "kind": "tool",
        "name": "xmi_patch_apply",
        "args": {
          "schema_version": "0.1.0",
          "project_id": "$project_id",
          "expected_version": "$version",
          "idempotency_key": "candidate",
          "patch": "$result.data.proposed_patch"
        },
        "form": "accept",
        "expect": {
          "ok": true,
          "version": 2,
          "first_status": "PROPOSED"
        }
      },
      {
        "kind": "tool",
        "name": "xmi_project_get",
        "args": {
          "schema_version": "0.1.0",
          "project_id": "$project_id"
        },
        "form": "none",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "user",
        "text": "听起来不错。"
      },
      {
        "kind": "assistant",
        "text": "建议已经保存为待确认候选；这不等于你已批准，收费问题仍未定。",
        "questions": [
          "是否先只讨论不收费的预约流程，还是现在比较收费选项？"
        ],
        "claims": {
          "confirmed_ids": [],
          "selected_mode": null,
          "saved": false,
          "readiness": "NOT_EVALUATED",
          "final_spec": false,
          "confirmation_mechanism_verified": false,
          "implementation_tasks": []
        }
      },
      {
        "kind": "tool",
        "name": "xmi_item_confirm",
        "args": {
          "schema_version": "0.1.0",
          "project_id": "$project_id",
          "expected_version": "$version",
          "idempotency_key": "confirm",
          "item_id": "$item.id",
          "item_version": "$item.version",
          "fingerprint": "$item.fingerprint",
          "intent": "CONFIRM"
        },
        "form": "decline",
        "expect": {
          "ok": false,
          "code": "OWNER_DECLINED",
          "version": 2,
          "first_status": "PROPOSED"
        }
      },
      {
        "kind": "assistant",
        "text": "确认窗口被拒绝，条目仍是待确认状态。",
        "questions": [
          "要修改哪一部分，还是先暂停？"
        ],
        "claims": {
          "confirmed_ids": [],
          "selected_mode": null,
          "saved": false,
          "readiness": "NOT_EVALUATED",
          "final_spec": false,
          "confirmation_mechanism_verified": false,
          "implementation_tasks": []
        }
      }
    ]
  },
